# Loaded by `vite build --mode capacitor` (the APK build).
# The webview has no same-origin server, so every /api and /audio call must be
# absolute. Point them at the live server.
VITE_API_BASE=https://danserv.co.uk

# Stream songs straight from R2 so playback doesn't need the API server.
# Uncomment once the songs have been copied to R2 (CLOUD-SETUP.md, part 2).
# VITE_MEDIA_BASE=https://media.danserv.co.uk

# Supabase is the same as the web build — these are public (anon) values.
# Copy the real values from your .env before building the APK, or rely on the
# fact that Vite also loads .env for any vars not overridden here.
