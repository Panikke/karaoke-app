# Copy this file to .env and fill in your credentials.
# Find Supabase keys: dashboard → your project → Settings → API

# ── Frontend (Vite bakes these in at build time) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Base URL for the Express API + /audio files.
# Leave EMPTY for the web build (served behind nginx — relative URLs resolve
# same-origin). The Capacitor/APK build sets this to the live server URL via
# .env.capacitor, because the webview has no same-origin backend.
# VITE_API_BASE=

# Public address of the Cloudflare R2 bucket holding the songs. When set, the
# app streams media straight from R2, so songs still play if the API is down.
# Leave unset to load media from the API server's /audio/ route.
# VITE_MEDIA_BASE=https://media.danserv.co.uk

# ── Server only (never exposed to the browser) ────────────────────────────────
# Dashboard → Settings → API → service_role key  (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Optional — defaults shown
# PORT=3001
# HOST=127.0.0.1
# AUDIO_DIR=/var/www/karaoke-app/audio
# STATIC_DIR=            # path to dist/ to serve the website from this server

# ── Cloudflare R2 media storage (optional; see CLOUD-SETUP.md) ────────────────
# Set all five to store songs in R2 instead of AUDIO_DIR.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=karaoke-media
# R2_PUBLIC_URL=https://media.danserv.co.uk
